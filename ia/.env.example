# Copy to .env (git-ignored). Never commit .env.
# Which brain answers /preguntar: ollama (free, local) | claude (paid API) | plantilla (no AI)
ROTAHALCON_PROVEEDOR=ollama
OLLAMA_MODELO=qwen2.5:7b   # more accurate, ~10-30 s; qwen2.5:3b is faster (~3-15 s)
# Only if you use claude:
ANTHROPIC_API_KEY=
ROTAHALCON_MODELO=claude-opus-5-5
ROTAHALCON_ESFUERZO=low
ROTAHALCON_HIBRIDO=true
